#!/bin/sh
# Pre-commit check: Biome over the staged files, a type check of the whole
# tree, and the checks that every plugin's copy of the shared library and every
# effort variant of den's implementer still match their sources. It never
# writes, since a hook that reformats what is about to be committed hides the
# change from the person committing it. A failure is fixed with `npm run fix`,
# `npm run plugin-lib` or `npm run agent-variants` and staged again.
#
# `npm install` at the repository root points `core.hooksPath` here.
set -eu

cd "$(git rev-parse --show-toplevel)"

for tool in biome tsc; do
  if [ ! -f "node_modules/.bin/$tool" ]; then
    echo "pre-commit: node_modules/.bin/$tool is missing." >&2
    echo "pre-commit: run \`npm install\` at the repository root, and commit from" >&2
    echo "pre-commit: somewhere \`node\` is on PATH. A GUI git client often is not." >&2
    exit 1
  fi
done

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on PATH, and the copy check runs on it." >&2
  echo "pre-commit: commit from somewhere \`node\` is on PATH. A GUI git client" >&2
  echo "pre-commit: often is not." >&2
  exit 1
fi

# --staged reads the working-tree content of every staged file, so a partially
# staged file is checked as it is on disk rather than as it will be committed.
node_modules/.bin/biome check --staged --error-on-warnings --no-errors-on-unmatched
node_modules/.bin/tsc --noEmit

# Read-only, like everything above it: it names every copy that drifted and
# every file in a plugin's `lib/` that nothing put there, and leaves the fix to
# `npm run plugin-lib`.
node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/plugin-lib.mts --check

# The same for the implementer's effort variants, which `npm run agent-variants`
# writes from `plugins/den/agents/implementer.md`.
node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/agent-variants.mts --check

{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/package-lock.json",
			// A workflow script is the body of a function, with a top-level
			// return, which Biome cannot parse as a module.
			"!plugins/*/workflows",
			"!.claude/workflows",
			// Vendored marked stays byte for byte as its authors publish it.
			"!plugins/den/lib/plan/marked.min.js"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				// Bracket access on an index signature is what tsconfig's
				// `noPropertyAccessFromIndexSignature` requires.
				"useLiteralKeys": "off"
			},
			"style": {
				// Configuration reaches a hook through argv, not the environment.
				"noProcessEnv": "on",
				// A default export lets each importer name the same thing
				// differently.
				"noDefaultExport": "on",
				"useNamingConvention": {
					"level": "on",
					"options": {
						"conventions": [
							{
								// Object literals here spell wire formats: hook input
								// fields (`session_id`, `to_model`) and child process
								// environments (`HOME`). Hook code stays camelCase.
								"selector": { "kind": "objectLiteralProperty" },
								"formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
							}
						]
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}

{
	"description": "Review-triage and implementer-triage relays, the reminder on an edit to text an agent follows, and autonomy's start and its rules after a compaction.",
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/review-triage-inject"
					},
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/implementer-triage-inject"
					}
				]
			}
		],
		"UserPromptExpansion": [
			{
				"matcher": "^den:autonomy-start$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/autonomy-start \"${CLAUDE_PROJECT_DIR}\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "compact",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/autonomy-after-compact"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^SubagentHandback$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/review-triage-flag"
					},
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/implementer-triage-flag"
					}
				]
			},
			{
				"matcher": "^(Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/agent-text-audit"
					}
				]
			}
		]
	}
}

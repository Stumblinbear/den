{
	"description": "Review-triage and implementer-diagnostics relays.",
	"hooks": {
		"SubagentStop": [
			{
				"matcher": "den:flag-reviewer",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/review-triage-flag"
					}
				]
			},
			{
				"matcher": "den:implementer-opus|den:implementer-haiku|den:implementer-fable|den:red-green-fixer",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/implementer-diagnostics-flag"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/review-triage-inject"
					},
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/implementer-diagnostics-inject"
					}
				]
			}
		]
	}
}

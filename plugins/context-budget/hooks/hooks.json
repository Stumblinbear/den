{
	"description": "Per-model context-budget notice, measured from the transcript on every tool call and prompt, and the resume guard on SendMessage.",
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/context-budget --config \"${CLAUDE_PLUGIN_DATA}/config.toml\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/context-budget --config \"${CLAUDE_PLUGIN_DATA}/config.toml\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "SendMessage",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/shared/launch.mjs\" --data \"${CLAUDE_PLUGIN_DATA}\" hooks/resume-guard --config \"${CLAUDE_PLUGIN_DATA}/config.toml\""
					}
				]
			}
		]
	}
}

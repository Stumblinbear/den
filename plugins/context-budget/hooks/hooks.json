{
  "description": "Per-model context-budget notice, measured from the transcript on every tool call and prompt, and the resume cost gate on SendMessage.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/context-budget.mjs\" --defaults \"${CLAUDE_PLUGIN_ROOT}/hooks/config.toml\" --overrides \"${CLAUDE_PLUGIN_DATA}/config.toml\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/context-budget.mjs\" --defaults \"${CLAUDE_PLUGIN_ROOT}/hooks/config.toml\" --overrides \"${CLAUDE_PLUGIN_DATA}/config.toml\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/resume-cost-gate.mjs\""
          }
        ]
      }
    ]
  }
}
